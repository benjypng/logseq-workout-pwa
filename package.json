{
  "name": "logseq-workout-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "sidecar": "bun run sidecar/server.ts",
    "start": "bun run sidecar & SIDECAR_PID=$!; trap 'kill $SIDECAR_PID 2>/dev/null' EXIT INT TERM; bun run dev",
    "build": "bunx vite build",
    "serve": "bun run sidecar/serve.ts",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check --write . && tsc -b"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "idb": "^8.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.0.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
